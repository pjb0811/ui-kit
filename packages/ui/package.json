{
  "name": "@repo/ui",
  "version": "5.4.6",
  "description": "Modern React UI component library built with TypeScript, Tailwind CSS, and Radix UI. Featuring atoms, molecules, organisms and layout templates for building beautiful interfaces.",
  "keywords": [
    "react",
    "ui",
    "components",
    "typescript",
    "tailwindcss",
    "radix-ui",
    "design-system",
    "accessibility",
    "a11y"
  ],
  "author": {
    "name": "jbpark",
    "url": "https://github.com/pjb0811"
  },
  "license": "MIT",
  "homepage": "https://github.com/pjb0811/ui-kit",
  "repository": {
    "type": "git",
    "url": "https://github.com/pjb0811/ui-kit",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/pjb0811/ui-kit/issues"
  },
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./Typography": "./src/components/atoms/typography/index.ts",
    "./Button": "./src/components/atoms/button.tsx",
    "./Tag": "./src/components/atoms/tag.tsx",
    "./Card": "./src/components/molecules/card.tsx",
    "./Space": "./src/components/molecules/space.tsx",
    "./Menu": "./src/components/molecules/menu/index.ts",
    "./Reveals": "./src/components/molecules/reveals/index.ts",
    "./Layout": "./src/components/templates/layout/index.ts",
    "./utils": "./src/lib/utils/index.ts",
    "./core": "./src/core/index.ts",
    "./providers": "./src/providers/index.ts",
    "./style.css": "./src/globals.css"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "check-dynamic-classes": "node scripts/check-dynamic-tailwind-classes.mjs",
    "check-api-surface": "node scripts/check-api-surface.mjs",
    "check-preflight-reset": "node scripts/check-preflight-reset.mjs",
    "check-ssr-smoke": "node --import ./scripts/loaders/css-stub.mjs scripts/check-ssr-smoke.mjs",
    "check-regression-net": "pnpm run check-api-surface && pnpm run check-preflight-reset && pnpm run check-ssr-smoke",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc -b",
    "prepublishOnly": "node scripts/prepare-publish.mjs",
    "postpublish": "node scripts/restore-package.mjs"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.39.5",
    "postcss": "^8.5.26",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@jbpark/use-hooks": "^4.0.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.2",
    "swiper": "^14.1.0",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
