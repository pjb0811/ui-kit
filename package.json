{
  "name": "ui-kit",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check-dynamic-classes": "turbo run check-dynamic-classes",
  "check-regression-net": "turbo run check-regression-net",
    "prepare": "husky",
    "publish-ui": "cd packages/ui && npm publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write",
    "./apps/web/**/*.{js,jsx,ts,tsx}": [
      "bash -c 'cd ./apps/web && pnpm lint'",
      "bash -c 'cd ./apps/web && pnpm check-types'"
    ],
    "./apps/docs/**/*.{js,jsx,ts,tsx}": [
      "bash -c 'cd ./apps/docs && pnpm lint'",
      "bash -c 'cd ./apps/docs && pnpm check-types'"
    ],
    "./packages/ui/**/*.{js,jsx,ts,tsx}": [
      "bash -c 'cd ./packages/ui && pnpm lint'",
      "bash -c 'cd ./packages/ui && pnpm check-types'"
    ]
  }
}
