{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "check-dynamic-classes": {
      "dependsOn": ["^check-dynamic-classes"]
    },
    "check-orphaned-docs": {
      "inputs": [
        "docs/**",
        "sidebars.ts",
        "scripts/check-orphaned-docs.mjs",
        "$TURBO_ROOT$/packages/ui/src/components/*/index.ts"
      ]
    },
    "check-regression-net": {
      "dependsOn": ["build"],
      "inputs": [
        "dist/**",
        "scripts/**",
        "package.json",
        "package.publish.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
